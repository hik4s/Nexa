# NEXA Finance local development configuration.
# Copy this file to .env and set a local-only password.
# Never commit the real .env file.

POSTGRES_HOST=localhost
POSTGRES_DB=nexa_finance
POSTGRES_USER=nexa
POSTGRES_PASSWORD=replace_with_a_local_dev_password
POSTGRES_PORT=5432
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_POOL_MIN_IDLE=2

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_WINDOW_SECONDS=60
